/* pages/login/login.wxss */
.academy-login {
  position: relative;
  min-height: 100vh;
  padding: 48rpx 36rpx 40rpx;
  box-sizing: border-box;
  overflow: hidden;
  background:
    radial-gradient(circle at 14% 10%, rgba(184, 50, 42, 0.10), transparent 22%),
    radial-gradient(circle at 88% 7%, rgba(185, 133, 61, 0.12), transparent 24%),
    linear-gradient(rgba(126, 92, 55, 0.055) 1rpx, transparent 1rpx),
    var(--paper-bg);
  background-size: 100% 100%, 100% 100%, 100% 54rpx, 100% 100%;
}

.academy-login::after {
  content: "";
  position: absolute;
  left: -40rpx;
  right: -40rpx;
  bottom: -10rpx;
  height: 360rpx;
  opacity: 0.52;
  pointer-events: none;
  background:
    radial-gradient(ellipse at 22% 82%, rgba(23, 107, 87, 0.18), transparent 34%),
    radial-gradient(ellipse at 74% 76%, rgba(96, 116, 135, 0.14), transparent 32%),
    linear-gradient(180deg, transparent, rgba(239, 224, 192, 0.72));
}

.login-header {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 28rpx 0 38rpx;
}

.academy-brand-mark {
  width: 132rpx;
  height: 132rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  border-radius: 50%;
  color: #FFF8ED;
  background:
    radial-gradient(circle at 68% 28%, rgba(255, 248, 237, 0.22), transparent 22%),
    linear-gradient(180deg, var(--academy-green), var(--academy-green-deep));
  border: 6rpx solid rgba(185, 133, 61, 0.46);
  box-shadow: 0 14rpx 30rpx rgba(14, 77, 63, 0.20);
}

.brand-mark-text {
  font-size: 70rpx;
  font-weight: 800;
  line-height: 1;
}

.brush-title {
  font-size: 64rpx;
  line-height: 1.12;
  color: var(--ink-title);
  font-weight: 800;
  letter-spacing: 0;
}

.app-name {
  margin-top: 10rpx;
  font-size: 28rpx;
  line-height: 1.4;
  color: var(--academy-green);
  font-weight: 700;
}

.app-slogan {
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--ink-soft);
}

.seal-line {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-top: 22rpx;
}

.seal-mini {
  min-width: 58rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  color: var(--seal-red);
  font-size: 22rpx;
  font-weight: 800;
  border: 3rpx solid rgba(184, 50, 42, 0.66);
  border-radius: 6rpx;
  background-color: rgba(245, 216, 212, 0.36);
  transform: rotate(-4deg);
}

.seal-copy {
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--ink-soft);
}

.login-content {
  position: relative;
  z-index: 1;
  width: 100%;
  box-sizing: border-box;
  padding: 40rpx 32rpx 34rpx;
  overflow: hidden;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.74), rgba(251, 245, 232, 0.96)),
    var(--paper-card);
  border: 2rpx solid rgba(185, 133, 61, 0.34);
  border-left: 8rpx solid var(--academy-green);
  border-radius: 14rpx;
  box-shadow: var(--shadow-paper);
}

.login-content::before {
  content: "";
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  top: 0;
  bottom: 0;
  opacity: 0.18;
  pointer-events: none;
  background: repeating-linear-gradient(
    0deg,
    transparent 0,
    transparent 45rpx,
    rgba(126, 92, 55, 0.24) 46rpx,
    transparent 47rpx
  );
}

.welcome-text {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 38rpx;
}

.title {
  font-size: 38rpx;
  line-height: 1.35;
  color: var(--ink-title);
  font-weight: 800;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--ink-soft);
  text-align: center;
}

.login-btn {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  color: #FFF8ED;
  font-size: 30rpx;
  font-weight: 700;
  border-radius: 44rpx;
  background: linear-gradient(180deg, var(--academy-green), var(--academy-green-deep));
  box-shadow: 0 12rpx 22rpx rgba(14, 77, 63, 0.20);
}

.login-btn[disabled] {
  color: rgba(255, 248, 237, 0.72);
  background: linear-gradient(180deg, rgba(23, 107, 87, 0.58), rgba(14, 77, 63, 0.58));
}

.login-btn::after {
  border: none;
}

.tips {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  margin-top: 28rpx;
}

.tip-text,
.link {
  font-size: 24rpx;
  line-height: 1.6;
}

.tip-text {
  color: var(--ink-muted);
}

.link {
  color: var(--academy-green);
  margin: 0 4rpx;
  text-decoration: underline;
}

.login-footer-note {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  text-align: center;
  color: var(--ink-muted);
  font-size: 24rpx;
  line-height: 1.5;
}
