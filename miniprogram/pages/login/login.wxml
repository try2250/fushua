<!-- pages/login/login.wxml -->
<view class="container login-container academy-login">
  <view class="login-header academy-hero landscape-wash">
    <view class="academy-brand-mark">
      <text class="brand-mark-text">文</text>
    </view>
    <text class="brush-title">文墨学苑</text>
    <text class="app-name">付刷</text>
    <text class="app-slogan">中学题库 · 智学善教</text>
    <view class="seal-line">
      <text class="seal-mini">入学</text>
      <text class="seal-copy">以答促学　以教成章</text>
    </view>
  </view>

  <view class="login-content academy-panel">
    <view class="welcome-text">
      <text class="title">微信授权登录</text>
      <text class="subtitle">同步你的身份、班级与学习记录</text>
    </view>

    <button
      class="login-btn"
      bindtap="handleWechatLogin"
      disabled="{{loading}}"
    >
      <text wx:if="{{!loading}}">微信一键登录</text>
      <text wx:if="{{loading}}">登录中...</text>
    </button>

    <view class="tips">
      <text class="tip-text">登录即表示同意</text>
      <text class="link">《用户协议》</text>
      <text class="tip-text">和</text>
      <text class="link">《隐私政策》</text>
    </view>
  </view>

  <view class="login-footer-note">
    <text>一方纸卷，记录每一次进步</text>
  </view>
</view>
