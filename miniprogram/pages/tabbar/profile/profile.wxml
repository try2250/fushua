<!--pages/tabbar/profile/profile.wxml-->
<view class="profile-container">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <view class="user-avatar">
      <text class="avatar-text">{{userInfo.username ? userInfo.username.substring(0, 1) : '用'}}</text>
    </view>
    <view class="user-info">
      <view class="user-name">{{userInfo.username || '未登录'}}</view>
      <view class="user-role">{{isStudent ? '学生' : isTeacher ? '教师' : '未知角色'}}</view>
      <view class="user-phone" wx:if="{{userInfo.phone}}">{{userInfo.phone}}</view>
    </view>
    <view class="edit-btn" bindtap="handleEditProfile">
      <text>编辑</text>
    </view>
  </view>

  <!-- 学生统计数据 -->
  <view class="stats-card" wx:if="{{isStudent}}">
    <view class="stats-title">学习统计</view>
    <view class="stats-grid">
      <view class="stat-item">
        <view class="stat-value">{{stats.totalQuestions}}</view>
        <view class="stat-label">已刷题目</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{stats.correctRate}}%</view>
        <view class="stat-label">正确率</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{stats.completedAssignments}}/{{stats.totalAssignments}}</view>
        <view class="stat-label">完成作业</view>
      </view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-section">
    <view class="menu-item" bindtap="handleSettings">
      <view class="menu-item-left">
        <text class="menu-icon">⚙️</text>
        <text class="menu-label">设置</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
    <view class="menu-item" bindtap="handleAbout">
      <view class="menu-item-left">
        <text class="menu-icon">ℹ️</text>
        <text class="menu-label">关于</text>
      </view>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录按钮 -->
  <view class="logout-section">
    <button class="logout-btn" bindtap="handleLogout">退出登录</button>
  </view>
</view>
