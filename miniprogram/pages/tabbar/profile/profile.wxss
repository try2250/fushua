/* pages/tabbar/profile/profile.wxss */
.profile-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 用户信息卡片 */
.user-card {
  background-color: #ffffff;
  padding: 40rpx 30rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 60rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
}

.avatar-text {
  font-size: 48rpx;
  color: #ffffff;
  font-weight: bold;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.user-role {
  font-size: 24rpx;
  color: #999999;
  padding: 4rpx 12rpx;
  background-color: #f5f5f5;
  border-radius: 4rpx;
  display: inline-block;
  margin-bottom: 8rpx;
}

.user-phone {
  font-size: 26rpx;
  color: #666666;
}

.edit-btn {
  padding: 12rpx 24rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333333;
}

/* 统计数据卡片 */
.stats-card {
  background-color: #ffffff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.stats-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 24rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #1890ff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999999;
}

/* 功能菜单 */
.menu-section {
  background-color: #ffffff;
  margin-bottom: 20rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item-left {
  display: flex;
  align-items: center;
}

.menu-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.menu-label {
  font-size: 28rpx;
  color: #333333;
}

.menu-arrow {
  font-size: 48rpx;
  color: #cccccc;
  font-weight: 300;
}

/* 退出登录 */
.logout-section {
  padding: 0 30rpx;
  margin-top: 40rpx;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #ffffff;
  color: #ff4d4f;
  border-radius: 8rpx;
  font-size: 32rpx;
  text-align: center;
  border: none;
}

.logout-btn::after {
  border: none;
}

/* 朱砂印章笔记主题 */
.profile-container {
  background-color: var(--paper-bg);
  background-image: linear-gradient(rgba(126, 92, 55, 0.055) 1rpx, transparent 1rpx);
  background-size: 100% 52rpx;
}

.user-card,
.stats-card,
.menu-section {
  margin: 24rpx;
  background-color: var(--paper-card);
  border: 2rpx solid var(--line);
  border-left: 8rpx solid var(--seal-red);
  border-radius: 14rpx;
  box-shadow: var(--shadow-paper);
}

.user-card {
  position: relative;
}

.user-card::after {
  content: "在学";
  position: absolute;
  right: 28rpx;
  bottom: 22rpx;
  color: rgba(184, 50, 42, 0.42);
  border: 3rpx solid rgba(184, 50, 42, 0.30);
  border-radius: 8rpx;
  padding: 6rpx 10rpx;
  transform: rotate(-8deg);
  font-size: 22rpx;
}

.user-avatar {
  background: linear-gradient(180deg, var(--seal-red), var(--seal-red-deep));
  border: 4rpx solid rgba(255, 248, 237, 0.78);
}

.user-name,
.stats-title,
.menu-label {
  color: var(--ink);
}

.user-role {
  color: var(--seal-red);
  background-color: rgba(245, 216, 212, 0.58);
  border: 1rpx solid rgba(184, 50, 42, 0.24);
}

.user-phone,
.stat-label,
.menu-arrow {
  color: var(--ink-soft);
}

.edit-btn {
  color: var(--seal-red);
  background-color: rgba(245, 216, 212, 0.54);
}

.stat-value {
  color: var(--seal-red);
}

.menu-item {
  border-bottom: 1rpx dashed rgba(126, 92, 55, 0.24);
}

.logout-section {
  padding: 0 24rpx;
}

.logout-btn {
  background-color: rgba(251, 245, 232, 0.92);
  color: var(--seal-red);
  border: 2rpx solid rgba(184, 50, 42, 0.28);
}

/* 文墨学苑主题深化 */
.user-card,
.stats-card,
.menu-section {
  border-color: rgba(185, 133, 61, 0.32);
  border-left-color: var(--academy-green);
}

.user-avatar {
  background: linear-gradient(180deg, var(--academy-green), var(--academy-green-deep));
}

.user-role,
.edit-btn,
.stat-value {
  color: var(--academy-green);
  background-color: rgba(23, 107, 87, 0.10);
  border-color: rgba(23, 107, 87, 0.24);
}

.logout-btn {
  color: var(--academy-green);
  border-color: rgba(23, 107, 87, 0.24);
}
