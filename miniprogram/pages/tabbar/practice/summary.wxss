.summary-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx;
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f0e8, #fff);
}
.summary-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 60rpx 0 40rpx;
}
.score-ring {
  font-size: 80rpx;
  font-weight: bold;
  color: #176B57;
  width: 200rpx;
  height: 200rpx;
  line-height: 200rpx;
  text-align: center;
  border: 8rpx solid #176B57;
  border-radius: 50%;
}
.score-label {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #666;
}
.summary-stats {
  display: flex;
  gap: 40rpx;
  margin: 40rpx 0;
}
.stat-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 120rpx;
}
.stat-num {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
}
.stat-num.correct { color: #176B57; }
.stat-num.wrong { color: #ff5733; }
.stat-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
}
.streak-card {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #fff3e0;
  padding: 24rpx 40rpx;
  border-radius: 16rpx;
  margin: 20rpx 0;
}
.streak-icon { font-size: 40rpx; }
.streak-text { font-size: 28rpx; color: #e65100; }
.summary-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 60rpx;
  width: 100%;
}
.btn-primary {
  background: #176B57;
  color: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 32rpx;
}
.btn-secondary {
  background: #f5f5f5;
  color: #333;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 32rpx;
}
