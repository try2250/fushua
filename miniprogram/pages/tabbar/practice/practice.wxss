/* pages/tabbar/practice/practice.wxss */
.academy-practice {
  min-height: 100vh;
  padding-bottom: 40rpx;
  background:
    radial-gradient(circle at 92% 5%, rgba(185, 133, 61, 0.12), transparent 20%),
    linear-gradient(rgba(126, 92, 55, 0.055) 1rpx, transparent 1rpx),
    var(--paper-bg);
  background-size: 100% 100%, 100% 54rpx, 100% 100%;
}

.practice-hero {
  position: relative;
  overflow: hidden;
  min-height: 250rpx;
  padding: 34rpx 32rpx;
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  border-bottom: 2rpx solid rgba(185, 133, 61, 0.22);
}

.practice-hero::after {
  content: "";
  position: absolute;
  right: -20rpx;
  bottom: -12rpx;
  width: 310rpx;
  height: 150rpx;
  opacity: 0.44;
  pointer-events: none;
  background:
    radial-gradient(ellipse at 20% 82%, rgba(23, 107, 87, 0.26), transparent 35%),
    radial-gradient(ellipse at 72% 78%, rgba(96, 116, 135, 0.18), transparent 38%);
}

.hero-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  max-width: 520rpx;
}

.hero-eyebrow {
  margin-bottom: 12rpx;
  color: var(--academy-green);
  font-size: 24rpx;
  line-height: 1.5;
  font-weight: 700;
}

.hero-title {
  color: var(--ink-title);
  font-size: 42rpx;
  line-height: 1.28;
  font-weight: 800;
}

.hero-desc {
  margin-top: 14rpx;
  color: var(--ink-soft);
  font-size: 25rpx;
  line-height: 1.7;
}

.seal-stamp,
.seal-mini {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--seal-red);
  font-weight: 800;
  border: 3rpx solid rgba(184, 50, 42, 0.62);
  border-radius: 8rpx;
  background-color: rgba(245, 216, 212, 0.36);
}

.seal-stamp {
  position: relative;
  z-index: 1;
  width: 70rpx;
  height: 70rpx;
  font-size: 32rpx;
  transform: rotate(-8deg);
}

.seal-mini {
  width: 48rpx;
  height: 48rpx;
  font-size: 22rpx;
  transform: rotate(-5deg);
}

.stats-header {
  display: flex;
  justify-content: space-around;
  margin: 24rpx 24rpx 22rpx;
  padding: 28rpx 18rpx;
  overflow: hidden;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.74), rgba(251, 245, 232, 0.96)),
    var(--paper-card);
  border: 2rpx solid rgba(185, 133, 61, 0.34);
  border-left: 8rpx solid var(--academy-green);
  border-radius: 14rpx;
  box-shadow: var(--shadow-paper);
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 0;
}

.stat-value {
  margin-bottom: 8rpx;
  color: var(--academy-green);
  font-size: 44rpx;
  line-height: 1.15;
  font-weight: 800;
}

.stat-label {
  color: var(--ink-muted);
  font-size: 23rpx;
  line-height: 1.4;
}

.question-card {
  position: relative;
  margin: 0 24rpx 24rpx;
  padding: 30rpx;
  box-sizing: border-box;
}

.question-card::after {
  content: "练";
  position: absolute;
  right: 24rpx;
  top: 90rpx;
  width: 62rpx;
  height: 62rpx;
  line-height: 62rpx;
  text-align: center;
  color: rgba(184, 50, 42, 0.46);
  border: 3rpx solid rgba(184, 50, 42, 0.36);
  border-radius: 8rpx;
  transform: rotate(-8deg);
  font-size: 30rpx;
  font-weight: 800;
  pointer-events: none;
}

.question-header {
  position: relative;
  z-index: 1;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx dashed rgba(126, 92, 55, 0.30);
}

.question-info {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.question-number {
  color: var(--ink-title);
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 800;
}

.question-type,
.question-difficulty {
  padding: 4rpx 12rpx;
  color: var(--academy-green);
  background-color: rgba(23, 107, 87, 0.10);
  border: 1rpx solid rgba(23, 107, 87, 0.24);
  border-radius: 6rpx;
  font-size: 23rpx;
  line-height: 1.45;
}

.difficulty-1 {
  color: var(--jade);
  background-color: rgba(79, 124, 107, 0.12);
}

.difficulty-2 {
  color: var(--gild);
  background-color: rgba(185, 133, 61, 0.12);
}

.difficulty-3 {
  color: var(--seal-red);
  background-color: rgba(184, 50, 42, 0.12);
}

.question-actions {
  display: flex;
  gap: 14rpx;
  flex-shrink: 0;
}

.action-btn {
  min-width: 64rpx;
  text-align: center;
  color: var(--academy-green);
  font-size: 24rpx;
  line-height: 1.5;
  padding: 6rpx 10rpx;
  border: 1rpx solid rgba(23, 107, 87, 0.20);
  border-radius: 8rpx;
  background-color: rgba(23, 107, 87, 0.08);
}

.question-content {
  position: relative;
  z-index: 1;
  margin-bottom: 32rpx;
}

.ink-note {
  margin-bottom: 14rpx;
}

.question-text {
  color: var(--ink);
  font-size: 31rpx;
  line-height: 1.72;
}

.options-list {
  position: relative;
  z-index: 1;
  margin-bottom: 32rpx;
}

.option-item {
  display: flex;
  align-items: flex-start;
  padding: 22rpx 24rpx;
  margin-bottom: 16rpx;
  background-color: rgba(255, 250, 238, 0.84);
  border: 2rpx solid rgba(126, 92, 55, 0.18);
  border-radius: 10rpx;
  transition: all 0.25s;
}

.option-item.selected {
  background-color: rgba(23, 107, 87, 0.10);
  border-color: var(--academy-green);
}

.option-item.correct {
  background-color: rgba(79, 124, 107, 0.12);
  border-color: var(--jade);
}

.option-item.wrong {
  background-color: rgba(184, 50, 42, 0.10);
  border-color: var(--seal-red);
}

.option-label {
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  color: var(--ink-soft);
  font-size: 27rpx;
  font-weight: 800;
  border: 1rpx solid var(--line);
  border-radius: 50%;
  background-color: var(--paper-card);
}

.option-item.selected .option-label {
  color: #FFF8ED;
  background-color: var(--academy-green);
}

.option-item.correct .option-label {
  color: #FFF8ED;
  background-color: var(--jade);
}

.option-item.wrong .option-label {
  color: #FFF8ED;
  background-color: var(--seal-red);
}

.option-text {
  flex: 1;
  color: var(--ink);
  font-size: 28rpx;
  line-height: 1.58;
}

.result-tip {
  position: relative;
  z-index: 1;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 14rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
  border: 2rpx dashed rgba(185, 133, 61, 0.34);
  border-radius: 10rpx;
  background-color: rgba(251, 245, 232, 0.88);
}

.result-icon {
  font-size: 38rpx;
  line-height: 1;
  font-weight: 800;
}

.result-text {
  font-size: 28rpx;
  line-height: 1.4;
  font-weight: 800;
}

.correct-tip .result-icon,
.correct-tip .result-text {
  color: var(--jade);
}

.wrong-tip .result-icon,
.wrong-tip .result-text,
.correct-answer {
  color: var(--seal-red);
}

.correct-answer {
  font-size: 24rpx;
  line-height: 1.5;
}

.result-seal {
  margin-left: auto;
}

.action-buttons {
  position: relative;
  z-index: 1;
  display: flex;
  gap: 18rpx;
}

.btn-primary,
.btn-secondary {
  flex: 1;
  height: 86rpx;
  line-height: 86rpx;
  padding: 0 18rpx;
  text-align: center;
  border-radius: 43rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.btn-primary {
  color: #FFF8ED;
  background: linear-gradient(180deg, var(--academy-green), var(--academy-green-deep));
  box-shadow: 0 10rpx 18rpx rgba(14, 77, 63, 0.18);
}

.btn-secondary {
  color: var(--ink);
  background-color: rgba(251, 245, 232, 0.92);
  border: 2rpx solid var(--line);
}

.btn-primary::after,
.btn-secondary::after {
  border: none;
}

.loading-container,
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 30rpx;
  color: var(--ink-muted);
}

.empty-text {
  margin-bottom: 40rpx;
  color: var(--ink-muted);
  font-size: 28rpx;
}

.streak-badge .stat-value {
  color: #ff5733;
  font-size: 36rpx;
}
