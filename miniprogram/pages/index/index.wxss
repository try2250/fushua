/* pages/index/index.wxss */
.index-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  border-radius: 40rpx;
  background-color: #ffffff;
}

.app-name {
  font-size: 64rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 20rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.welcome-section,
.user-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 600rpx;
}

.welcome-text {
  font-size: 32rpx;
  color: #ffffff;
  margin-bottom: 40rpx;
  text-align: center;
}

.btn-primary {
  width: 100%;
  background-color: #ffffff;
  color: #667eea;
  border-radius: 50rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.1);
}

.user-role {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 10rpx;
}

/* 朱砂印章笔记主题 */
.index-container {
  background:
    radial-gradient(circle at 20% 10%, rgba(184, 50, 42, 0.12), transparent 22%),
    linear-gradient(rgba(126, 92, 55, 0.055) 1rpx, transparent 1rpx),
    var(--paper-bg);
  background-size: 100% 100%, 100% 52rpx, 100% 100%;
}

.logo {
  background-color: var(--paper-card);
  border: 4rpx solid rgba(184, 50, 42, 0.26);
  box-shadow: var(--shadow-paper);
}

.app-name {
  color: var(--seal-red);
}

.app-slogan,
.welcome-text,
.user-role {
  color: var(--ink-soft);
}

.welcome-section,
.user-section {
  background-color: var(--paper-card);
  border: 2rpx solid var(--line);
  border-left: 8rpx solid var(--seal-red);
  border-radius: 14rpx;
  box-shadow: var(--shadow-paper);
  padding: 34rpx;
}

.btn-primary {
  background: linear-gradient(180deg, var(--seal-red), var(--seal-red-deep));
  color: #FFF8ED;
  border-radius: 10rpx;
}

/* 文墨学苑主题深化 */
.index-container {
  background:
    radial-gradient(circle at 18% 12%, rgba(23, 107, 87, 0.12), transparent 22%),
    linear-gradient(rgba(126, 92, 55, 0.055) 1rpx, transparent 1rpx),
    var(--paper-bg);
}

.app-name {
  color: var(--ink-title);
}

.welcome-section,
.user-section {
  border-color: rgba(185, 133, 61, 0.32);
  border-left-color: var(--academy-green);
}

.btn-primary {
  background: linear-gradient(180deg, var(--academy-green), var(--academy-green-deep));
}
