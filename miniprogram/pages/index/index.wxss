/* pages/index/index.wxss */
.index-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.logo {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 40rpx;
  border-radius: 40rpx;
  background-color: #ffffff;
}

.app-name {
  font-size: 64rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 20rpx;
}

.app-slogan {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.welcome-section,
.user-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 600rpx;
}

.welcome-text {
  font-size: 32rpx;
  color: #ffffff;
  margin-bottom: 40rpx;
  text-align: center;
}

.btn-primary {
  width: 100%;
  background-color: #ffffff;
  color: #667eea;
  border-radius: 50rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 16rpx rgba(0, 0, 0, 0.1);
}

.user-role {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 10rpx;
}
