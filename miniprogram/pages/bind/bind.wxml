<!-- pages/bind/bind.wxml -->
<view class="container bind-container">
  <!-- 步骤 1: 输入手机号和验证码 -->
  <view class="bind-step" wx:if="{{step === 1}}">
    <view class="step-header">
      <text class="step-title">绑定手机号</text>
      <text class="step-subtitle">首次使用需要绑定手机号</text>
    </view>

    <view class="form-section">
      <view class="form-item">
        <text class="label">手机号</text>
        <input
          class="input"
          type="number"
          maxlength="11"
          placeholder="请输入手机号"
          value="{{phone}}"
          bindinput="onPhoneInput"
        />
      </view>

      <view class="form-item">
        <text class="label">验证码</text>
        <view class="code-input-wrapper">
          <input
            class="input code-input"
            type="number"
            maxlength="6"
            placeholder="请输入验证码"
            value="{{code}}"
            bindinput="onCodeInput"
          />
          <button
            class="send-code-btn"
            bindtap="sendCode"
            disabled="{{countdown > 0}}"
          >
            <text wx:if="{{countdown === 0}}">发送验证码</text>
            <text wx:else>{{countdown}}秒后重试</text>
          </button>
        </view>
      </view>

      <button class="btn-primary mt-20" bindtap="nextStep">
        下一步
      </button>
    </view>
  </view>

  <!-- 步骤 2: 选择角色和班级 -->
  <view class="bind-step" wx:if="{{step === 2}}">
    <view class="step-header">
      <text class="step-title">选择身份</text>
      <text class="step-subtitle">请选择您的身份和相关信息</text>
    </view>

    <view class="form-section">
      <view class="form-item">
        <text class="label">身份</text>
        <radio-group class="radio-group" bindchange="onRoleChange">
          <label class="radio-item">
            <radio value="student" checked="{{role === 'student'}}" />
            <text>学生</text>
          </label>
          <label class="radio-item">
            <radio value="teacher" checked="{{role === 'teacher'}}" />
            <text>教师</text>
          </label>
        </radio-group>
      </view>

      <!-- 学生选择班级 -->
      <view class="form-item" wx:if="{{role === 'student'}}">
        <text class="label">班级</text>
        <picker
          mode="selector"
          range="{{classes}}"
          range-key="name"
          value="{{class_id}}"
          bindchange="onClassChange"
        >
          <view class="picker">
            <text wx:if="{{!class_id}}" class="placeholder">请选择班级</text>
            <text wx:else>{{classes[class_id].name}}</text>
          </view>
        </picker>
      </view>

      <!-- 教师输入邀请码 -->
      <view class="form-item" wx:if="{{role === 'teacher'}}">
        <text class="label">邀请码</text>
        <input
          class="input"
          type="text"
          placeholder="请输入教师邀请码"
          value="{{invite_code}}"
          bindinput="onInviteCodeInput"
        />
      </view>

      <button
        class="btn-primary mt-20"
        bindtap="handleBind"
        disabled="{{loading}}"
      >
        <text wx:if="{{!loading}}">完成绑定</text>
        <text wx:else>绑定中...</text>
      </button>
    </view>
  </view>
</view>
