/* pages/bind/bind.wxss */
.bind-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 40rpx 30rpx;
}

.bind-step {
  width: 100%;
}

.step-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.step-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.step-subtitle {
  font-size: 28rpx;
  color: #999999;
}

.form-section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
}

/* 开发期提示样式 */
.dev-notice {
  margin-bottom: 24rpx;
  padding: 16rpx 24rpx;
  background-color: #fff7e6;
  border-left: 4rpx solid #faad14;
  border-radius: 8rpx;
}

.notice-text {
  font-size: 26rpx;
  color: #d48806;
  line-height: 1.5;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333333;
}

.placeholder {
  color: #999999;
}

.code-input-wrapper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.code-input {
  flex: 1;
}

.send-code-btn {
  width: 200rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  background-color: #1890ff;
  color: #ffffff;
  border-radius: 8rpx;
  font-size: 26rpx;
  text-align: center;
}

.send-code-btn[disabled] {
  background-color: #d9d9d9;
  color: #999999;
}

.send-code-btn::after {
  border: none;
}

.radio-group {
  display: flex;
  gap: 40rpx;
}

.radio-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.radio-item text {
  font-size: 28rpx;
  color: #333333;
}

.picker {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
  color: #333333;
}

.picker .placeholder {
  color: #999999;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #1890ff;
  color: #ffffff;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  border: none;
}

.btn-primary[disabled] {
  background-color: #d9d9d9;
  color: #999999;
}

.btn-primary::after {
  border: none;
}

.mt-20 {
  margin-top: 40rpx;
}

/* 朱砂印章笔记主题 */
.bind-container {
  background-color: var(--paper-bg);
  background-image: linear-gradient(rgba(126, 92, 55, 0.055) 1rpx, transparent 1rpx);
  background-size: 100% 52rpx;
}

.step-title {
  color: var(--seal-red);
}

.step-subtitle {
  color: var(--ink-soft);
}

.form-section {
  background-color: var(--paper-card);
  border: 2rpx solid var(--line);
  border-left: 8rpx solid var(--seal-red);
  border-radius: 14rpx;
  box-shadow: var(--shadow-paper);
}

.label,
.input,
.radio-item text,
.picker {
  color: var(--ink);
}

.input,
.picker {
  background-color: rgba(255, 250, 238, 0.82);
  border: 1rpx solid var(--line);
}

.placeholder,
.picker .placeholder {
  color: var(--ink-muted);
}

.send-code-btn,
.btn-primary {
  background: linear-gradient(180deg, var(--seal-red), var(--seal-red-deep));
  color: #FFF8ED;
}

.send-code-btn[disabled],
.btn-primary[disabled] {
  background: rgba(126, 92, 55, 0.16);
  color: var(--ink-muted);
}

/* 文墨学苑主题深化 */
.step-title {
  color: var(--ink-title);
}

.form-section {
  border-color: rgba(185, 133, 61, 0.32);
  border-left-color: var(--academy-green);
}

.send-code-btn,
.btn-primary {
  background: linear-gradient(180deg, var(--academy-green), var(--academy-green-deep));
}
