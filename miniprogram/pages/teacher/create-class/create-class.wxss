/* pages/teacher/create-class/create-class.wxss */
.create-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 40rpx 30rpx;
}

.form-section {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 40rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 16rpx;
  font-weight: 500;
}

.required {
  color: #ff4d4f;
  margin-right: 4rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 28rpx;
  color: #333333;
}

.placeholder {
  color: #999999;
}

.tip-text {
  font-size: 24rpx;
  color: #999999;
  margin-top: 12rpx;
}

.btn-submit {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  border: none;
}

.btn-submit::after {
  border: none;
}

/* 朱砂印章笔记主题 */
.create-container {
  background-color: var(--paper-bg);
  background-image: linear-gradient(rgba(126, 92, 55, 0.055) 1rpx, transparent 1rpx);
  background-size: 100% 52rpx;
}

.form-section {
  background-color: var(--paper-card);
  border: 2rpx solid var(--line);
  border-left: 8rpx solid var(--seal-red);
  border-radius: 14rpx;
  box-shadow: var(--shadow-paper);
}

.label,
.input {
  color: var(--ink);
}

.required {
  color: var(--seal-red);
}

.input {
  background-color: rgba(255, 250, 238, 0.82);
  border: 1rpx solid var(--line);
}

.placeholder,
.tip-text {
  color: var(--ink-muted);
}

.btn-submit {
  background: linear-gradient(180deg, var(--seal-red), var(--seal-red-deep));
}

/* 文墨学苑主题深化 */
.form-section {
  border-color: rgba(185, 133, 61, 0.32);
  border-left-color: var(--academy-green);
}

.required {
  color: var(--seal-red);
}

.btn-submit {
  background: linear-gradient(180deg, var(--academy-green), var(--academy-green-deep));
}
