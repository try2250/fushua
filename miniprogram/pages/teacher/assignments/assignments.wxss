/* pages/teacher/assignments/assignments.wxss */
.assignments-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 顶部操作栏 */
.header-bar {
  background-color: #ffffff;
  padding: 20rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.filter-section {
  flex: 1;
}

.picker-display {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

.picker-text {
  font-size: 28rpx;
  color: #333333;
  margin-right: 8rpx;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999999;
}

.btn-create {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  border-radius: 8rpx;
  font-size: 26rpx;
  border: none;
  margin-left: 20rpx;
  line-height: 1.5;
}

.btn-create::after {
  border: none;
}

/* 作业列表 */
.assignments-list {
  padding: 20rpx 30rpx;
}

.assignment-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.assignment-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-right: 20rpx;
}

.status-badge {
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 22rpx;
  flex-shrink: 0;
}

.status-active {
  background-color: #e6f7ff;
  color: #1890ff;
}

.status-ended {
  background-color: #f5f5f5;
  color: #999999;
}

.card-info {
  margin-bottom: 20rpx;
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.info-label {
  font-size: 26rpx;
  color: #666666;
  min-width: 180rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333333;
}

.card-actions {
  display: flex;
  justify-content: flex-end;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.btn-action {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  border: none;
  line-height: 1.5;
}

.btn-action::after {
  border: none;
}

.btn-delete {
  background-color: #fff1f0;
  color: #ff4d4f;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 30rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 30rpx;
  font-size: 28rpx;
  color: #999999;
}

/* 朱砂印章笔记主题 */
.assignments-container {
  background-color: var(--paper-bg);
  background-image: linear-gradient(rgba(126, 92, 55, 0.055) 1rpx, transparent 1rpx);
  background-size: 100% 52rpx;
}

.header-bar,
.assignment-card {
  background-color: var(--paper-card);
  border: 2rpx solid var(--line);
  border-left: 8rpx solid var(--seal-red);
  border-radius: 14rpx;
  box-shadow: var(--shadow-paper);
}

.header-bar {
  margin: 22rpx 24rpx;
}

.assignments-list {
  padding: 0 24rpx 24rpx;
}

.assignment-card {
  position: relative;
}

.assignment-card::after {
  content: "布置";
  position: absolute;
  right: 24rpx;
  bottom: 24rpx;
  color: rgba(184, 50, 42, 0.34);
  border: 3rpx solid rgba(184, 50, 42, 0.26);
  border-radius: 8rpx;
  padding: 6rpx 10rpx;
  transform: rotate(-7deg);
  font-size: 22rpx;
}

.picker-display {
  background-color: rgba(255, 250, 238, 0.82);
  border: 1rpx solid var(--line);
}

.picker-text,
.assignment-title,
.info-value,
.empty-text {
  color: var(--ink);
}

.picker-arrow,
.info-label,
.empty-desc {
  color: var(--ink-soft);
}

.btn-create {
  background: linear-gradient(180deg, var(--seal-red), var(--seal-red-deep));
}

.status-badge {
  color: var(--seal-red);
  background-color: rgba(245, 216, 212, 0.58);
  border: 2rpx solid rgba(184, 50, 42, 0.28);
}

.status-ended {
  color: var(--ink-soft);
  background-color: rgba(126, 92, 55, 0.10);
}

.card-actions {
  border-top: 1rpx dashed rgba(126, 92, 55, 0.26);
}

.btn-delete {
  color: var(--seal-red);
  background-color: rgba(245, 216, 212, 0.54);
}

/* 文墨学苑主题深化 */
.header-bar,
.assignment-card {
  border-color: rgba(185, 133, 61, 0.32);
  border-left-color: var(--academy-green);
}

.btn-create {
  background: linear-gradient(180deg, var(--academy-green), var(--academy-green-deep));
}

.status-badge,
.btn-delete {
  color: var(--academy-green);
  background-color: rgba(23, 107, 87, 0.10);
  border-color: rgba(23, 107, 87, 0.24);
}
