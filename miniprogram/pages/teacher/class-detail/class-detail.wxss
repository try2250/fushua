/* pages/teacher/class-detail/class-detail.wxss */
.detail-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 班级信息头部 */
.class-header {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.header-content {
  flex: 1;
}

.class-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.class-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meta-item {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.meta-divider {
  color: rgba(255, 255, 255, 0.5);
}

.btn-invite {
  padding: 12rpx 24rpx;
  background-color: rgba(255, 255, 255, 0.2);
  color: #ffffff;
  border-radius: 8rpx;
  font-size: 26rpx;
  border: none;
  line-height: 1.5;
}

.btn-invite::after {
  border: none;
}

/* 标签栏 */
.tabs-bar {
  display: flex;
  background-color: #ffffff;
  padding: 0 30rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 30rpx 0;
  position: relative;
}

.tab-label {
  font-size: 28rpx;
  color: #666666;
}

.tab-item.active .tab-label {
  color: #1890ff;
  font-weight: bold;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background-color: #1890ff;
  border-radius: 2rpx;
}

/* 成员列表 */
.members-list {
  padding: 20rpx 30rpx;
}

.member-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.member-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: bold;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.member-meta {
  display: flex;
  align-items: center;
}

.meta-text {
  font-size: 24rpx;
  color: #999999;
}

.member-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.btn-action {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  border: none;
  line-height: 1.5;
}

.btn-action::after {
  border: none;
}

.btn-view {
  background-color: #e6f7ff;
  color: #1890ff;
}

.btn-remove {
  background-color: #fff1f0;
  color: #ff4d4f;
}

/* 统计内容 */
.stats-content {
  padding: 20rpx 30rpx;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 30rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 30rpx;
  font-size: 28rpx;
  color: #999999;
}

/* 朱砂印章笔记主题 */
.detail-container {
  background-color: var(--paper-bg);
  background-image: linear-gradient(rgba(126, 92, 55, 0.055) 1rpx, transparent 1rpx);
  background-size: 100% 52rpx;
}

.class-header {
  margin: 22rpx 24rpx;
  padding: 32rpx 28rpx;
  background: var(--paper-card);
  border: 2rpx solid var(--line);
  border-left: 8rpx solid var(--seal-red);
  border-radius: 14rpx;
  box-shadow: var(--shadow-paper);
}

.class-name,
.tab-item.active .tab-label,
.empty-text {
  color: var(--seal-red);
}

.meta-item,
.meta-divider,
.meta-text,
.empty-desc {
  color: var(--ink-soft);
}

.btn-invite {
  color: var(--seal-red);
  background-color: rgba(245, 216, 212, 0.54);
  border: 2rpx solid rgba(184, 50, 42, 0.28);
}

.tabs-bar {
  margin: 0 24rpx 22rpx;
  padding: 8rpx;
  background-color: var(--paper-card);
  border: 2rpx solid var(--line);
  border-radius: 14rpx;
  box-shadow: var(--shadow-paper);
}

.tab-item {
  padding: 22rpx 0;
  border-radius: 10rpx;
}

.tab-label {
  color: var(--ink-soft);
}

.tab-item.active {
  background-color: rgba(245, 216, 212, 0.54);
}

.tab-item.active::after {
  bottom: 6rpx;
  background-color: var(--seal-red);
}

.members-list,
.stats-content {
  padding: 0 24rpx 24rpx;
}

.member-card {
  background-color: var(--paper-card);
  border: 2rpx solid var(--line);
  border-left: 8rpx solid var(--seal-red);
  border-radius: 14rpx;
  box-shadow: var(--shadow-paper);
}

.member-avatar {
  background: linear-gradient(180deg, var(--seal-red), var(--seal-red-deep));
}

.member-name {
  color: var(--ink);
}

.btn-view {
  color: var(--seal-red);
  background-color: rgba(245, 216, 212, 0.54);
}

.btn-remove {
  color: var(--ink-soft);
  background-color: rgba(126, 92, 55, 0.10);
}

/* 文墨学苑主题深化 */
.class-header,
.tabs-bar,
.member-card {
  border-color: rgba(185, 133, 61, 0.32);
  border-left-color: var(--academy-green);
}

.class-name,
.tab-item.active .tab-label,
.btn-invite,
.btn-view {
  color: var(--academy-green);
}

.btn-invite,
.tab-item.active,
.btn-view {
  background-color: rgba(23, 107, 87, 0.10);
  border-color: rgba(23, 107, 87, 0.24);
}

.tab-item.active::after,
.member-avatar {
  background: var(--academy-green);
}
