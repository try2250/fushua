/* pages/teacher/students/students.wxss */
.students-container {
  min-height: 100vh;
  background-color: #f5f5f5;
}

/* 顶部筛选栏 */
.filter-bar {
  background-color: #ffffff;
  padding: 20rpx 30rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.picker-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx;
  background-color: #f5f5f5;
  border-radius: 8rpx;
}

.picker-text {
  font-size: 28rpx;
  color: #333333;
}

.picker-arrow {
  font-size: 20rpx;
  color: #999999;
}

/* 学生列表 */
.students-list {
  padding: 20rpx 30rpx;
}

.student-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.student-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 32rpx;
  color: #ffffff;
  font-weight: bold;
}

.student-info {
  flex: 1;
  min-width: 0;
}

.student-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 8rpx;
}

.student-meta {
  font-size: 24rpx;
  color: #999999;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #1890ff;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 30rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 30rpx;
  font-size: 28rpx;
  color: #999999;
}

/* 朱砂印章笔记主题 */
.students-container {
  background-color: var(--paper-bg);
  background-image: linear-gradient(rgba(126, 92, 55, 0.055) 1rpx, transparent 1rpx);
  background-size: 100% 52rpx;
}

.filter-bar,
.student-card {
  background-color: var(--paper-card);
  border: 2rpx solid var(--line);
  border-left: 8rpx solid var(--seal-red);
  border-radius: 14rpx;
  box-shadow: var(--shadow-paper);
}

.filter-bar {
  margin: 22rpx 24rpx;
}

.students-list {
  padding: 0 24rpx 24rpx;
}

.picker-display {
  background-color: rgba(255, 250, 238, 0.82);
  border: 1rpx solid var(--line);
}

.picker-text,
.student-name,
.empty-text {
  color: var(--ink);
}

.picker-arrow,
.student-meta,
.stat-label,
.empty-desc {
  color: var(--ink-soft);
}

.student-avatar {
  background: linear-gradient(180deg, var(--seal-red), var(--seal-red-deep));
}

.stats-grid {
  border-top: 1rpx dashed rgba(126, 92, 55, 0.26);
}

.stat-value {
  color: var(--seal-red);
}

/* 文墨学苑主题深化 */
.filter-bar,
.student-card {
  border-color: rgba(185, 133, 61, 0.32);
  border-left-color: var(--academy-green);
}

.student-avatar {
  background: linear-gradient(180deg, var(--academy-green), var(--academy-green-deep));
}

.stat-value {
  color: var(--academy-green);
}
