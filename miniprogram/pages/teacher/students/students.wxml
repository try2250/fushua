<!--pages/teacher/students/students.wxml-->
<view class="students-container">
  <!-- 顶部筛选栏 -->
  <view class="filter-bar">
    <picker
      mode="selector"
      range="{{classes}}"
      range-key="name"
      value="{{classIndex}}"
      bindchange="handleClassChange"
    >
      <view class="picker-display">
        <text class="picker-text">
          {{classes[classIndex] ? classes[classIndex].name : '请选择班级'}}
        </text>
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- 学生列表 -->
  <view class="students-list">
    <view
      class="student-card"
      wx:for="{{students}}"
      wx:key="id"
      bindtap="goToStudentDetail"
      data-id="{{item.id}}"
    >
      <view class="card-header">
        <view class="student-avatar">
          <text class="avatar-text">{{item.username ? item.username.substring(0, 1) : '学'}}</text>
        </view>
        <view class="student-info">
          <view class="student-name">{{item.username || '未知学生'}}</view>
          <view class="student-meta">📱 {{item.phone || '未绑定手机'}}</view>
        </view>
      </view>

      <view class="stats-grid">
        <view class="stat-item">
          <view class="stat-value">{{item.stats.total_practice || 0}}</view>
          <view class="stat-label">刷题数</view>
        </view>
        <view class="stat-item">
          <view class="stat-value">{{item.stats.completed_assignments || 0}}</view>
          <view class="stat-label">完成作业</view>
        </view>
        <view class="stat-item">
          <view class="stat-value">{{item.stats.accuracy_rate || 0}}%</view>
          <view class="stat-label">正确率</view>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-container" wx:if="{{!loading && students.length === 0}}">
      <text class="empty-icon">👥</text>
      <text class="empty-text">暂无学生</text>
      <text class="empty-desc">该班级还没有学生</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
