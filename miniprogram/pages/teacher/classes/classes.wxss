/* pages/teacher/classes/classes.wxss */
.classes-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 40rpx;
}

/* 头部操作栏 */
.header-bar {
  background-color: #ffffff;
  padding: 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.header-info {
  display: flex;
  align-items: center;
}

.info-text {
  font-size: 28rpx;
  color: #333333;
  font-weight: bold;
}

.btn-create {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #ffffff;
  border-radius: 8rpx;
  font-size: 26rpx;
  border: none;
  line-height: 1.5;
}

.btn-create::after {
  border: none;
}

.btn-icon {
  font-size: 32rpx;
  font-weight: bold;
}

/* 班级列表 */
.classes-list {
  padding: 0 30rpx;
}

.class-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 班级图标 */
.class-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.icon-text {
  font-size: 36rpx;
  color: #ffffff;
  font-weight: bold;
}

/* 班级信息 */
.class-info {
  flex: 1;
  min-width: 0;
}

.class-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.class-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #999999;
}

.meta-divider {
  color: #d9d9d9;
}

/* 操作按钮 */
.class-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
}

.btn-action {
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  border-radius: 8rpx;
  border: none;
  line-height: 1.5;
  min-width: 100rpx;
}

.btn-action::after {
  border: none;
}

.btn-edit {
  background-color: #e6f7ff;
  color: #1890ff;
}

.btn-delete {
  background-color: #fff1f0;
  color: #ff4d4f;
}

/* 空状态 */
.empty-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 30rpx;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 32rpx;
  color: #333333;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999999;
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 30rpx;
  font-size: 28rpx;
  color: #999999;
}
