/* pages/teacher/classes/classes.wxss */
.academy-teacher {
  min-height: 100vh;
  padding-bottom: 42rpx;
  background:
    radial-gradient(circle at 10% 9%, rgba(23, 107, 87, 0.10), transparent 22%),
    linear-gradient(rgba(126, 92, 55, 0.055) 1rpx, transparent 1rpx),
    var(--paper-bg);
  background-size: 100% 100%, 100% 54rpx, 100% 100%;
}

.teacher-ledger-header {
  position: relative;
  overflow: hidden;
  min-height: 250rpx;
  padding: 34rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  border-bottom: 2rpx solid rgba(185, 133, 61, 0.22);
}

.teacher-ledger-header::after {
  content: "";
  position: absolute;
  right: -26rpx;
  bottom: -16rpx;
  width: 330rpx;
  height: 150rpx;
  opacity: 0.44;
  pointer-events: none;
  background:
    radial-gradient(ellipse at 18% 82%, rgba(23, 107, 87, 0.28), transparent 34%),
    radial-gradient(ellipse at 76% 76%, rgba(96, 116, 135, 0.16), transparent 38%);
}

.teacher-ledger-copy {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
  flex: 1;
}

.hero-eyebrow {
  margin-bottom: 12rpx;
  color: var(--academy-green);
  font-size: 24rpx;
  line-height: 1.5;
  font-weight: 700;
}

.hero-title {
  color: var(--ink-title);
  font-size: 42rpx;
  line-height: 1.28;
  font-weight: 800;
}

.hero-desc {
  margin-top: 14rpx;
  color: var(--ink-soft);
  font-size: 25rpx;
  line-height: 1.7;
}

.btn-create {
  position: relative;
  z-index: 1;
  min-width: 156rpx;
  height: 70rpx;
  line-height: 70rpx;
  padding: 0 24rpx;
  color: #FFF8ED;
  border-radius: 35rpx;
  font-size: 26rpx;
  font-weight: 700;
  background: linear-gradient(180deg, var(--academy-green), var(--academy-green-deep));
  box-shadow: 0 10rpx 18rpx rgba(14, 77, 63, 0.18);
}

.btn-create::after {
  border: none;
}

.header-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 24rpx 24rpx 22rpx;
  padding: 24rpx 26rpx;
  box-sizing: border-box;
  overflow: hidden;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.74), rgba(251, 245, 232, 0.96)),
    var(--paper-card);
  border: 2rpx solid rgba(185, 133, 61, 0.34);
  border-left: 8rpx solid var(--academy-green);
  border-radius: 14rpx;
  box-shadow: var(--shadow-paper);
}

.header-info {
  display: flex;
  align-items: center;
}

.info-text {
  color: var(--ink-title);
  font-size: 28rpx;
  line-height: 1.45;
  font-weight: 800;
}

.seal-mini {
  min-width: 64rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  color: var(--seal-red);
  font-size: 22rpx;
  font-weight: 800;
  border: 3rpx solid rgba(184, 50, 42, 0.62);
  border-radius: 8rpx;
  background-color: rgba(245, 216, 212, 0.36);
  transform: rotate(-5deg);
}

.classes-list {
  padding: 0 24rpx;
}

.class-card {
  position: relative;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 28rpx 24rpx;
  box-sizing: border-box;
}

.class-card::after {
  content: "班";
  position: absolute;
  right: 22rpx;
  top: 22rpx;
  width: 54rpx;
  height: 54rpx;
  line-height: 54rpx;
  text-align: center;
  color: rgba(184, 50, 42, 0.34);
  border: 3rpx solid rgba(184, 50, 42, 0.28);
  border-radius: 8rpx;
  transform: rotate(-8deg);
  pointer-events: none;
}

.class-icon {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 22rpx;
  color: #FFF8ED;
  border-radius: 18rpx;
  background:
    radial-gradient(circle at 72% 26%, rgba(255, 248, 237, 0.22), transparent 22%),
    linear-gradient(180deg, var(--academy-green), var(--academy-green-deep));
  box-shadow: 0 10rpx 18rpx rgba(14, 77, 63, 0.14);
}

.icon-text {
  font-size: 34rpx;
  line-height: 1;
  font-weight: 800;
}

.class-info {
  flex: 1;
  min-width: 0;
  padding-right: 18rpx;
}

.class-name {
  margin-bottom: 12rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  color: var(--ink-title);
  font-size: 31rpx;
  line-height: 1.45;
  font-weight: 800;
}

.class-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.meta-item {
  color: var(--ink-soft);
  font-size: 23rpx;
  line-height: 1.45;
}

.meta-divider {
  color: rgba(126, 92, 55, 0.34);
}

.class-actions {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  flex-shrink: 0;
}

.btn-action {
  min-width: 96rpx;
  height: 52rpx;
  line-height: 52rpx;
  padding: 0 16rpx;
  border-radius: 26rpx;
  font-size: 24rpx;
  text-align: center;
}

.btn-action::after {
  border: none;
}

.btn-edit {
  color: var(--academy-green);
  background-color: rgba(23, 107, 87, 0.10);
  border: 1rpx solid rgba(23, 107, 87, 0.22);
}

.btn-delete {
  color: var(--seal-red);
  background-color: rgba(184, 50, 42, 0.10);
  border: 1rpx solid rgba(184, 50, 42, 0.22);
}

.empty-container,
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 30rpx;
  color: var(--ink-muted);
}

.empty-icon {
  margin-bottom: 20rpx;
  color: var(--academy-green);
  font-size: 92rpx;
  line-height: 1;
}

.empty-text {
  margin-bottom: 12rpx;
  color: var(--ink-title);
  font-size: 32rpx;
  line-height: 1.45;
  font-weight: 800;
}

.empty-desc,
.loading-container {
  color: var(--ink-muted);
  font-size: 26rpx;
  line-height: 1.5;
}
