<!--pages/teacher/assignment-detail/assignment-detail.wxml-->
<view class="detail-container">
  <!-- 作业信息头部 -->
  <view class="assignment-header" wx:if="{{assignment}}">
    <view class="assignment-title">{{assignment.title}}</view>
    <view class="header-info">
      <view class="info-item">
        <text>📚 班级：{{assignment.class_name || '未指定'}}</text>
      </view>
      <view class="info-item">
        <text>📝 题目数：{{assignment.question_count || 0}} 题</text>
      </view>
      <view class="info-item">
        <text>⏰ 截止时间：{{formatDate(assignment.deadline)}}</text>
      </view>
    </view>
  </view>

  <!-- 统计卡片 -->
  <view class="stats-section">
    <view class="stats-card">
      <view class="stat-item">
        <view class="stat-value">{{getSubmittedCount()}}/{{getTotalStudents()}}</view>
        <view class="stat-label">完成人数</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{getCompletionRate()}}%</view>
        <view class="stat-label">完成率</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{getAverageScore()}}</view>
        <view class="stat-label">平均分</view>
      </view>
    </view>
  </view>

  <!-- 提交记录列表 -->
  <view class="records-section">
    <view class="section-title">提交记录</view>

    <view
      class="record-card"
      wx:for="{{records}}"
      wx:key="id"
      bindtap="handleViewRecord"
      data-id="{{item.id}}"
    >
      <view class="record-header">
        <view class="student-info">
          <view class="student-avatar">
            <text class="avatar-text">{{item.student_name ? item.student_name.substring(0, 1) : '学'}}</text>
          </view>
          <text class="student-name">{{item.student_name || '未知学生'}}</text>
        </view>
        <view class="status-badge {{item.submitted_at ? 'status-submitted' : 'status-pending'}}">
          {{item.submitted_at ? '已提交' : '未提交'}}
        </view>
      </view>

      <view class="record-info" wx:if="{{item.submitted_at}}">
        <view class="info-row">
          <text class="info-label">提交时间：</text>
          <text class="info-value">{{formatDate(item.submitted_at)}}</text>
        </view>
        <view class="info-row" wx:if="{{item.score !== null}}">
          <text class="info-label">得分：</text>
          <text class="info-value score-value">{{item.score}} 分</text>
        </view>
        <view class="info-row" wx:if="{{item.correct_count !== null}}">
          <text class="info-label">正确题数：</text>
          <text class="info-value">{{item.correct_count}}/{{assignment.question_count || 0}}</text>
        </view>
      </view>
    </view>

    <!-- 空状态 -->
    <view class="empty-container" wx:if="{{!loading && records.length === 0}}">
      <text class="empty-icon">📋</text>
      <text class="empty-text">暂无提交记录</text>
      <text class="empty-desc">等待学生提交作业</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <text>加载中...</text>
  </view>
</view>
