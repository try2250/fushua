/* pages/assignment-detail/assignment-detail.wxss */
.detail-container {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding-bottom: 120rpx;
}

/* 作业信息头部 */
.assignment-header {
  background-color: #ffffff;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
}

.header-info {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.info-text {
  font-size: 26rpx;
  color: #666666;
}

.info-divider {
  color: #d9d9d9;
}

.header-status {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.status-badge {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.status-pending {
  background-color: #fff7e6;
  color: #faad14;
}

.status-completed {
  background-color: #f6ffed;
  color: #52c41a;
}

.score-text {
  font-size: 28rpx;
  color: #1890ff;
  font-weight: bold;
}

/* 题目导航 */
.question-nav {
  background-color: #ffffff;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
}

.nav-title {
  font-size: 28rpx;
  color: #333333;
  margin-bottom: 16rpx;
}

.nav-scroll {
  width: 100%;
  white-space: nowrap;
}

.nav-items {
  display: inline-flex;
  gap: 16rpx;
}

.nav-item {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background-color: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666666;
  flex-shrink: 0;
}

.nav-item.answered {
  background-color: #e6f7ff;
  color: #1890ff;
}

.nav-item.active {
  background-color: #1890ff;
  color: #ffffff;
  font-weight: bold;
}

/* 题目卡片 */
.question-card {
  background-color: #ffffff;
  margin: 0 30rpx 20rpx;
  border-radius: 16rpx;
  padding: 30rpx;
}

.question-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.question-number {
  font-size: 28rpx;
  color: #333333;
  font-weight: bold;
}

.question-type {
  font-size: 24rpx;
  color: #1890ff;
  padding: 4rpx 12rpx;
  background-color: #e6f7ff;
  border-radius: 4rpx;
}

.question-content {
  margin-bottom: 32rpx;
}

.question-text {
  font-size: 32rpx;
  color: #333333;
  line-height: 1.6;
}

/* 选项列表 */
.options-list {
  margin-bottom: 24rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  background-color: #f5f5f5;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.option-item.selected {
  background-color: #e6f7ff;
  border-color: #1890ff;
}

.option-item.correct {
  background-color: #f6ffed;
  border-color: #52c41a;
}

.option-item.wrong {
  background-color: #fff1f0;
  border-color: #ff4d4f;
}

.option-label {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  background-color: #ffffff;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: bold;
  color: #666666;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.option-item.selected .option-label {
  background-color: #1890ff;
  color: #ffffff;
}

.option-item.correct .option-label {
  background-color: #52c41a;
  color: #ffffff;
}

.option-item.wrong .option-label {
  background-color: #ff4d4f;
  color: #ffffff;
}

.option-text {
  flex: 1;
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
}

/* 按钮 */
.btn-secondary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #f5f5f5;
  color: #333333;
  border-radius: 8rpx;
  font-size: 32rpx;
  text-align: center;
  border: none;
}

.btn-secondary::after {
  border: none;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background-color: #ffffff;
  padding: 20rpx 30rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0, 0, 0, 0.05);
  display: flex;
  gap: 20rpx;
}

.btn-nav {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #f5f5f5;
  color: #333333;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: center;
  border: none;
}

.btn-nav[disabled] {
  background-color: #f5f5f5;
  color: #d9d9d9;
}

.btn-nav::after {
  border: none;
}

.btn-submit {
  flex: 2;
  height: 88rpx;
  line-height: 88rpx;
  background-color: #1890ff;
  color: #ffffff;
  border-radius: 8rpx;
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  border: none;
}

.btn-submit::after {
  border: none;
}

/* 加载状态 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 30rpx;
  font-size: 28rpx;
  color: #999999;
}

/* 朱砂印章笔记主题 */
.detail-container {
  background-color: var(--paper-bg);
  background-image: linear-gradient(rgba(126, 92, 55, 0.055) 1rpx, transparent 1rpx);
  background-size: 100% 52rpx;
}

.assignment-header,
.question-nav,
.question-card {
  background-color: var(--paper-card);
  border: 2rpx solid var(--line);
  border-left: 8rpx solid var(--seal-red);
  border-radius: 14rpx;
  box-shadow: var(--shadow-paper);
}

.assignment-header,
.question-nav {
  margin: 22rpx 24rpx;
}

.question-card {
  position: relative;
  margin: 0 24rpx 24rpx;
}

.question-card::after {
  content: "答";
  position: absolute;
  right: 26rpx;
  top: 28rpx;
  width: 58rpx;
  height: 58rpx;
  line-height: 58rpx;
  text-align: center;
  color: rgba(184, 50, 42, 0.40);
  border: 3rpx solid rgba(184, 50, 42, 0.28);
  border-radius: 8rpx;
  transform: rotate(-8deg);
}

.header-title,
.nav-title,
.question-number,
.question-text,
.option-text {
  color: var(--ink);
}

.info-text,
.info-divider {
  color: var(--ink-soft);
}

.status-badge {
  color: var(--seal-red);
  background-color: rgba(245, 216, 212, 0.58);
  border: 2rpx solid rgba(184, 50, 42, 0.32);
  border-radius: 6rpx;
}

.status-completed {
  color: var(--jade);
  background-color: rgba(79, 124, 107, 0.12);
  border-color: rgba(79, 124, 107, 0.32);
}

.score-text,
.question-type {
  color: var(--seal-red);
}

.question-type {
  background-color: rgba(245, 216, 212, 0.56);
}

.nav-item {
  background-color: rgba(126, 92, 55, 0.10);
  color: var(--ink-soft);
}

.nav-item.answered {
  background-color: rgba(245, 216, 212, 0.58);
  color: var(--seal-red);
}

.nav-item.active {
  background-color: var(--seal-red);
  color: #FFF8ED;
}

.question-header {
  border-bottom: 1rpx dashed rgba(126, 92, 55, 0.30);
}

.option-item {
  background-color: rgba(255, 250, 238, 0.82);
  border-color: rgba(126, 92, 55, 0.18);
}

.option-item.selected {
  background-color: rgba(245, 216, 212, 0.58);
  border-color: var(--seal-red);
}

.option-item.correct {
  background-color: rgba(79, 124, 107, 0.12);
  border-color: var(--jade);
}

.option-item.wrong {
  background-color: rgba(184, 50, 42, 0.10);
  border-color: var(--seal-red);
}

.option-label {
  background-color: var(--paper-card);
  color: var(--ink-soft);
  border: 1rpx solid var(--line);
}

.option-item.selected .option-label,
.option-item.wrong .option-label {
  background-color: var(--seal-red);
  color: #FFF8ED;
}

.option-item.correct .option-label {
  background-color: var(--jade);
  color: #FFF8ED;
}

.bottom-bar {
  background-color: rgba(251, 245, 232, 0.96);
  border-top: 2rpx solid var(--line);
}

.btn-submit {
  background: linear-gradient(180deg, var(--seal-red), var(--seal-red-deep));
}

/* 文墨学苑主题深化 */
.assignment-header,
.question-nav,
.question-card {
  border-color: rgba(185, 133, 61, 0.32);
  border-left-color: var(--academy-green);
}

.score-text,
.question-type {
  color: var(--academy-green);
}

.question-type,
.nav-item.answered,
.option-item.selected {
  background-color: rgba(23, 107, 87, 0.10);
}

.nav-item.answered,
.option-item.selected {
  color: var(--academy-green);
  border-color: var(--academy-green);
}

.nav-item.active,
.option-item.selected .option-label {
  background-color: var(--academy-green);
}

.btn-submit {
  background: linear-gradient(180deg, var(--academy-green), var(--academy-green-deep));
}
