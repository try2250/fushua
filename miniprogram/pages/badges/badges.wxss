.badges-container { padding: 30rpx; background: #f5f0e8; min-height: 100vh; }
.badges-header { text-align: center; margin-bottom: 40rpx; }
.badges-title { font-size: 40rpx; font-weight: bold; color: #333; }
.badges-grid { display: flex; flex-wrap: wrap; gap: 20rpx; }
.badge-card { width: calc(50% - 10rpx); background: #fff; border-radius: 16rpx; padding: 30rpx 20rpx; display: flex; flex-direction: column; align-items: center; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); }
.badge-card.locked { opacity: 0.5; }
.badge-icon { width: 80rpx; height: 80rpx; margin-bottom: 12rpx; }
.badge-name { font-size: 28rpx; font-weight: bold; color: #333; margin-bottom: 8rpx; }
.badge-desc { font-size: 22rpx; color: #999; text-align: center; }
.badge-status { font-size: 22rpx; color: #176B57; margin-top: 8rpx; }
.badge-status.locked { color: #ccc; }
