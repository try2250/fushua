.map-container { padding: 30rpx; background: #f5f0e8; min-height: 100vh; }
.subject-tabs { display: flex; gap: 20rpx; margin-bottom: 30rpx; }
.tab { padding: 12rpx 32rpx; border-radius: 20rpx; background: #fff; font-size: 28rpx; color: #666; }
.tab.active { background: #176B57; color: #fff; }
.chapter-grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.chapter-cell { width: calc(33.33% - 12rpx); aspect-ratio: 1; border-radius: 12rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; }
.color-green { background: #d4edda; border: 2rpx solid #28a745; }
.color-yellow { background: #fff3cd; border: 2rpx solid #ffc107; }
.color-grey { background: #f0f0f0; border: 2rpx solid #ddd; }
.chapter-name { font-size: 24rpx; font-weight: bold; color: #333; }
.chapter-progress { font-size: 20rpx; color: #999; margin-top: 6rpx; }
