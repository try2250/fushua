.onboarding-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 999; display: flex; align-items: center; justify-content: center; }
.onboarding-card { background: #fff; border-radius: 24rpx; padding: 60rpx 40rpx; width: 80%; text-align: center; }
.onboarding-step { font-size: 24rpx; color: #176B57; margin-bottom: 20rpx; }
.onboarding-guide { font-size: 32rpx; color: #333; display: block; margin-bottom: 40rpx; }
.onboarding-btn { background: #176B57; color: #fff; border-radius: 12rpx; padding: 20rpx 60rpx; font-size: 30rpx; }
