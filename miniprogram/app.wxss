/* app.wxss */
page {
  --paper-bg: #F7EEDC;
  --paper-card: #FBF5E8;
  --paper-deep: #EFE0C0;
  --ink: #2D241B;
  --ink-title: #2A2118;
  --ink-soft: #6F6253;
  --ink-muted: #9A8A73;
  --academy-green: #176B57;
  --academy-green-deep: #0E4D3F;
  --academy-green-soft: #DDEBE3;
  --seal-red: #B8322A;
  --seal-red-deep: #8E211C;
  --seal-red-soft: #F5D8D4;
  --jade: #4F7C6B;
  --blue-gray: #607487;
  --gold: #B78338;
  --gild: #B9853D;
  --line: rgba(126, 92, 55, 0.18);
  --shadow-paper: 0 10rpx 28rpx rgba(95, 65, 32, 0.10);
  --radius-card: 14rpx;
  min-height: 100vh;
  background-color: var(--paper-bg);
  color: var(--ink);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  letter-spacing: 0;
}

page::before {
  content: "";
  position: fixed;
  inset: 0;
  pointer-events: none;
  opacity: 0.45;
  background:
    linear-gradient(rgba(126, 92, 55, 0.055) 1rpx, transparent 1rpx) 0 0 / 100% 52rpx,
    radial-gradient(circle at 16% 12%, rgba(23, 107, 87, 0.10), transparent 22%),
    radial-gradient(circle at 88% 8%, rgba(185, 133, 61, 0.10), transparent 22%),
    var(--paper-bg);
  z-index: -1;
}

.paper-texture {
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.50), rgba(239, 224, 192, 0.42)),
    repeating-linear-gradient(0deg, rgba(126, 92, 55, 0.055) 0, rgba(126, 92, 55, 0.055) 1rpx, transparent 1rpx, transparent 34rpx),
    var(--paper-card);
}

.landscape-wash {
  background:
    radial-gradient(ellipse at 18% 82%, rgba(23, 107, 87, 0.13), transparent 34%),
    radial-gradient(ellipse at 74% 78%, rgba(96, 116, 135, 0.12), transparent 32%),
    linear-gradient(180deg, rgba(251, 245, 232, 0.20), rgba(239, 224, 192, 0.56));
}

.container {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.ledger-card,
.card {
  position: relative;
  overflow: hidden;
  background:
    linear-gradient(135deg, rgba(255, 255, 255, 0.72), rgba(251, 245, 232, 0.96)),
    var(--paper-card);
  border: 2rpx solid var(--line);
  border: 2rpx solid rgba(185, 133, 61, 0.32);
  border-left: 8rpx solid rgba(23, 107, 87, 0.82);
  border-radius: var(--radius-card);
  box-shadow: var(--shadow-paper);
}

.ledger-card::before,
.card::before {
  content: "";
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 0;
  height: 100%;
  pointer-events: none;
  opacity: 0.22;
  background: repeating-linear-gradient(
    0deg,
    transparent 0,
    transparent 45rpx,
    rgba(126, 92, 55, 0.22) 46rpx,
    transparent 47rpx
  );
}

.seal-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 96rpx;
  min-height: 44rpx;
  padding: 6rpx 16rpx;
  color: var(--seal-red);
  font-size: 24rpx;
  font-weight: 700;
  border: 3rpx solid rgba(184, 50, 42, 0.72);
  border-radius: 6rpx;
  background-color: rgba(245, 216, 212, 0.42);
  transform: rotate(-2deg);
}

.ink-note {
  color: var(--academy-green-deep);
  font-size: 24rpx;
  line-height: 1.5;
  padding-left: 18rpx;
  border-left: 4rpx solid rgba(184, 50, 42, 0.58);
}

.btn-primary,
.btn-submit,
.login-btn,
.btn-create {
  background: linear-gradient(180deg, var(--academy-green), var(--academy-green-deep));
  color: #FFF8ED;
  border: none;
  border-radius: 10rpx;
  box-shadow: 0 8rpx 16rpx rgba(14, 77, 63, 0.18);
}

.btn-secondary,
.btn-nav,
.send-code-btn {
  background-color: rgba(251, 245, 232, 0.92);
  color: var(--ink);
  border: 2rpx solid var(--line);
  border-radius: 10rpx;
}

button::after {
  border: none;
}

.text-primary {
  color: var(--academy-green);
}

.text-secondary {
  color: var(--ink-soft);
}

.text-muted {
  color: var(--ink-muted);
}

.text-success {
  color: var(--jade);
}

.text-error {
  color: var(--seal-red);
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--ink);
  margin-bottom: 16rpx;
}

.academy-title {
  color: var(--ink-title);
  font-weight: 700;
}

.academy-mark {
  color: var(--academy-green);
  background-color: var(--academy-green-soft);
  border: 1rpx solid rgba(23, 107, 87, 0.24);
}

.subtitle {
  font-size: 28rpx;
  color: var(--ink-soft);
  margin-bottom: 12rpx;
}

.list-item {
  background-color: var(--paper-card);
  padding: 24rpx;
  border-bottom: 1rpx solid var(--line);
}

.empty-state,
.loading,
.loading-container,
.empty-container {
  color: var(--ink-muted);
}

.flex {
  display: flex;
}

.flex-column {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-1 {
  flex: 1;
}

.mt-10 {
  margin-top: 10rpx;
}

.mt-20 {
  margin-top: 20rpx;
}

.mb-10 {
  margin-bottom: 10rpx;
}

.mb-20 {
  margin-bottom: 20rpx;
}

.ml-10 {
  margin-left: 10rpx;
}

.mr-10 {
  margin-right: 10rpx;
}
